NODE_ENV=development

# Telegram Bot API token from @BotFather.
# Leave empty for local foundation checks without starting a real bot.
BOT_TOKEN=

# Local SQLite database. Prisma creates prisma/dev.db during migration.
DATABASE_URL=file:./dev.db

# Optional: send known users a short message once per deployed version.
DEPLOY_NOTIFICATIONS_ENABLED=false

# Optional: voluntary support jar. Set a real URL only in runtime env.
# SUPPORT_BARREL_URL=https://send.monobank.ua/jar/...
# SUPPORT_BARREL_CURRENT_UAH=0
# SUPPORT_BARREL_GOAL_UAH=5000
# SUPPORT_BARREL_STATUS_UPDATED_AT=2026-06-16

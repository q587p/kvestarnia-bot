NODE_ENV=development

# Telegram Bot API token from @BotFather.
# Leave empty for local foundation checks without starting a real bot.
BOT_TOKEN=

# Local SQLite database. Prisma creates prisma/dev.db during migration.
DATABASE_URL=file:./dev.db

# Optional: send known users a short message once per deployed version.
DEPLOY_NOTIFICATIONS_ENABLED=false

# Optional: public Monobank jar URL copied from Monobank after creating the jar.
# Do NOT use the Telegram reward deep link here.
# SUPPORT_JAR_URL=https://send.monobank.ua/jar/<real-jar-id>
# SUPPORT_JAR_CURRENT_UAH=0
# SUPPORT_JAR_GOAL_UAH=5000
# SUPPORT_JAR_STATUS_UPDATED_AT=2026-06-16

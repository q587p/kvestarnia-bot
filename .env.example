NODE_ENV=development

# Telegram Bot API token from @BotFather.
# Leave empty for local foundation checks without starting a real bot.
BOT_TOKEN=

# Optional public bot username for generated Telegram deep links.
# Keep dev/prod bots separate, for example kvestarnia_dev_bot locally and kvestarnia_bot in production.
BOT_USERNAME=

# Local SQLite database. Prisma creates prisma/dev.db during migration.
DATABASE_URL=file:./dev.db

# Optional: send known users a short message once per deployed version.
DEPLOY_NOTIFICATIONS_ENABLED=false

# Sparse durable full-HP recovery notices. Disabled by default; follow the rollout runbook before enabling.
# Rows without queue progress for 24 hours are suppressed on their next bounded due claim.
HP_RECOVERY_NOTIFICATIONS_ENABLED=false

# Optional performance telemetry. Fast-call sampling is off by default;
# calls at or above 350 ms and measured failures are still logged.
KVESTARNIA_PERF_SAMPLE_RATE=0
KVESTARNIA_PERF_SLOW_MS=350
# Narrow Yeger trace override for controlled local diagnostics only.
YEGER_PERF_DEBUG=false

# Local-only value grant commands for playtesting.
# Never enable this on hosted production.
DEV_GRANT_COMMANDS_ENABLED=false

# Optional 0.2.15 production smoke flag for the temporary party-session foundation.
PARTY_SESSION_FOUNDATION_ENABLED=false

# Optional 0.2.17 production smoke flag for the level 8+ Big Barrel Brother route.
BIG_BARREL_BROTHER_RAID_ENABLED=false

# Optional 0.2.21 production smoke flags for Shynok table games.
# TAVERN_GAMES_ENABLED shows "🎲 Ігри за столом" only when at least one per-game flag is also enabled.
TAVERN_GAMES_ENABLED=false
TAVERN_GAME_TAVLEI_ENABLED=false
TAVERN_GAME_KOSTI_ENABLED=false
# TAVERN_GAME_MAX_STAKE=93
# TAVERN_GAME_CREATE_COOLDOWN_SEC=93

# Local/manual party-session helpers such as forced dev expiry.
# Keep this off for normal hosted production.
PARTY_SESSION_DEV_HELPERS_ENABLED=false
FIGHTING_CORNER_ONBOARDING_QUEST_ENABLED=false
FIGHTING_CORNER_ONBOARDING_QUEST_DEV_HELPERS_ENABLED=false

# Optional: public Monobank jar URL copied from Monobank after creating the jar.
# Do NOT use the Telegram reward deep link here.
# SUPPORT_JAR_URL=https://send.monobank.ua/jar/<real-jar-id>
# SUPPORT_JAR_CURRENT_UAH=0
# SUPPORT_JAR_GOAL_UAH=5000
# SUPPORT_JAR_STATUS_UPDATED_AT=2026-06-16

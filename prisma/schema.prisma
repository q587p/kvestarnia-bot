  updatedAt      DateTime     @updatedAt @map("updated_at")
  participants   GroupCombatParticipant[]
  actions        GroupCombatAction[]
  passageEncounter PendingPassageEncounter?
  uiPublicationClaims GroupCombatUiPublicationClaim[]
  weeklyContribution GuildWeeklyContribution?
  weeklyParticipantSnapshots GuildWeeklyParticipantSnapshot[]
  weeklyReconciliation GuildWeeklyReconciliation?

  @@index([status, turnExpiresAt, id])
  @@index([deliveryPending, deliveryAttemptedAt, updatedAt, id])
  @@index([status, terminalIntegrityCheckedAt, updatedAt, id])
  @@index([guildWeeklyGoalEligible, completedAt, id])
  @@map("group_combat_sessions")
}

model GroupCombatParticipant {
  id               String             @id @default(uuid())
  sessionId        String             @map("session_id")
  session          GroupCombatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  characterId      String             @map("character_id")
  character        Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  remortCount      Int                @map("remort_count")
  rosterOrder      Int                @map("roster_order")
  snapshotJson     Json               @map("snapshot_json")
  contributionJson Json               @map("contribution_json")
  settlementStatus String             @default("pending") @map("settlement_status")
  settlementAttempts Int              @default(0) @map("settlement_attempts")
  settlementReceiptJson Json?         @map("settlement_receipt_json")
  settledAt        DateTime?          @map("settled_at")
  chatId           BigInt?            @map("chat_id")
  messageId        Int?               @map("message_id")
  referenceVersion Int                @default(0) @map("reference_version")
  deliveredRevision Int               @default(0) @map("delivered_revision")
  replyKeyboardFingerprint String?     @map("reply_keyboard_fingerprint")
  replyKeyboardGeneration Int          @default(0) @map("reply_keyboard_generation")
  exitDeliveryState String            @default("none") @map("exit_delivery_state")
  exitDeliveryClaimToken String?       @map("exit_delivery_claim_token")
  exitDeliveryClaimedAt DateTime?      @map("exit_delivery_claimed_at")
  exitDeliveryMessageId Int?           @map("exit_delivery_message_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@unique([sessionId, characterId])
  @@unique([sessionId, rosterOrder])
  @@index([characterId, sessionId])
  @@map("group_combat_participants")
}

model GroupCombatAction {
  id               String             @id @default(uuid())
  sessionId        String             @map("session_id")
  session          GroupCombatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actorCharacterId String             @map("actor_character_id")
  actor            Character          @relation(fields: [actorCharacterId], references: [id], onDelete: Cascade)
  turn             Int
  actionKey        String             @map("action_key")
  targetKind       String             @map("target_kind")
  targetId         String             @map("target_id")
  payloadKey       String?            @map("payload_key")
  origin           String
  submittedAt      DateTime           @map("submitted_at")
  createdAt        DateTime           @default(now()) @map("created_at")

  @@unique([sessionId, turn, actorCharacterId])
  @@index([sessionId, turn])
  @@index([actorCharacterId])
  @@map("group_combat_actions")
}

model TavernGameSession {
  id                 String    @id @default(uuid())
  token              String    @unique
  gameKey            String    @map("game_key")
  status             String    @default("open")
  creatorCharacterId String    @map("creator_character_id")
  creator            Character @relation("TavernGameCreator", fields: [creatorCharacterId], references: [id], onDelete: Cascade)
  stakeGold          Int       @map("stake_gold")
  potGold            Int       @default(0) @map("pot_gold")
  seed               String
  rulesVersion       String    @map("rules_version")
  resultJson         Json?     @map("result_json")
  openedAt           DateTime  @map("opened_at")
  joinExpiresAt      DateTime  @map("join_expires_at")
  decisionExpiresAt  DateTime? @map("decision_expires_at")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  participants       TavernGameParticipant[]

  @@index([gameKey, status, joinExpiresAt])
  @@index([status, joinExpiresAt])
  @@index([status, decisionExpiresAt])
  @@index([creatorCharacterId, status])
  @@map("tavern_game_sessions")
}

model TavernGameParticipant {
  id               String    @id @default(uuid())
  sessionId        String    @map("session_id")
  session          TavernGameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  characterId      String    @map("character_id")
  character        Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  telegramUserId   BigInt    @map("telegram_user_id")
  displayName      String    @map("display_name")
  remortCount      Int       @default(0) @map("remort_count")
  status           String    @default("joined")
  stakeGold        Int       @map("stake_gold")
  payoutGold       Int       @default(0) @map("payout_gold")
  refundedGold     Int       @default(0) @map("refunded_gold")
  decisionJson     Json?     @map("decision_json")
  resultJson       Json?     @map("result_json")
  activeStakeKey   String?   @unique @map("active_stake_key")
  joinedAt         DateTime  @map("joined_at")
  decidedAt        DateTime? @map("decided_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([sessionId, characterId])
  @@index([characterId, status])
  @@index([sessionId, status])
  @@index([telegramUserId, status])
  @@map("tavern_game_participants")
}

model DailyAction {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  key         String
  localDate   String    @map("local_date")
  rewardXp    Int       @map("reward_xp")
  rewardGold  Int       @map("reward_gold")
  spentGold   Int       @default(0) @map("spent_gold")
  resultJson  Json?     @map("result_json")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([characterId, key, localDate])
  @@index([characterId, key, createdAt], map: "daily_actions_character_id_key_created_at_idx")
  @@index([key])
  @@map("daily_actions")
}

model HuntContract {
  id              String    @id @default(uuid())
  characterId     String    @map("character_id")
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  localPeriodId   String    @map("local_period_id")
  monsterId       String    @map("monster_id")
  contractToken   String    @map("contract_token")
  status          String    @default("posted")
  completedAction String?   @map("completed_action")
  rewardXp        Int?      @map("reward_xp")
  rewardGold      Int?      @map("reward_gold")
  rewardItemsJson Json?     @map("reward_items_json")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([characterId, localPeriodId])
  @@index([monsterId])
  @@index([localPeriodId])
  @@map("hunt_contracts")
}

model CharacterCooldown {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  key         String
  availableAt DateTime  @map("available_at")
  resultJson  Json?     @map("result_json")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([characterId, key])
  @@index([availableAt])
  @@map("character_cooldowns")
}

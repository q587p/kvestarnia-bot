generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id @default(uuid())
  // Telegram user ids are numeric; convert ctx.from.id to BigInt at the DB boundary.
  telegramUserId     BigInt     @unique @map("telegram_user_id")
  username           String?
  displayName        String?    @map("display_name")
  languageCode       String?    @map("language_code")
  lastActionAt       DateTime?  @map("last_action_at")
  lastSeenLocationId String?    @map("last_seen_location_id")
  currentRaidId      String?    @map("current_raid_id")
  currentAdventureId String?    @map("current_adventure_id")
  character          Character?
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@index([lastActionAt])
  @@index([lastSeenLocationId])
  @@index([currentRaidId])
  @@index([currentAdventureId])
  @@map("users")
}

model Character {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyActions DailyAction[]
  cooldowns CharacterCooldown[]
  items     CharacterItem[]
  equipment CharacterEquipment[]
  korchmaRoundPurchases KorchmaRoundPurchase[]
  korchmaRoundRecipients KorchmaRoundRecipient[]
  korchmaDrinkOrders KorchmaDrinkOrder[]
  drinkState CharacterDrinkState?
  drinkActivationAudits ShynokDrinkActivationAudit[]
  korchmaMantokSales KorchmaMantokSale[]
  itemTransfersSent ItemTransfer[] @relation("ItemTransferSender")
  itemTransfersReceived ItemTransfer[] @relation("ItemTransferReceiver")
  huntContracts HuntContract[]
  soloCombatSessions SoloCombatSession[]
  pendingPassageEncounters PendingPassageEncounter[]
  combatBalanceBattles CombatBalanceBattle[]
  barrelRaidNotifications BarrelRaidNotification[]
  mantokChestRuns MantokChestRun[]
  levelBarterExchanges LevelBarterExchange[]
  remortDrafts CharacterRemortDraft[]
  remorts CharacterRemort[]
  duelChallengesSent DuelChallenge[] @relation("DuelChallenger")
  duelChallengesReceived DuelChallenge[] @relation("DuelTarget")
  duelCombatSessionsAsChallenger DuelCombatSession[] @relation("DuelCombatChallenger")
  duelCombatSessionsAsTarget DuelCombatSession[] @relation("DuelCombatTarget")
  activeCombatLease ActiveCombatLease?
  name      String
  pronoun   String   @default("they")
  path      String   @default("boundary")
  raceId    String   @map("race_id")
  classId   String   @map("class_id")
  level     Int      @default(1)
  xp        Int      @default(0)
  gold      Int      @default(0)
  hpCurrent Int      @default(25) @map("hp_current")
  hpMax     Int      @default(25) @map("hp_max")
  manaCurrent Int    @default(10) @map("mana_current")
  manaMax   Int      @default(10) @map("mana_max")
  hpRegenAt DateTime? @map("hp_regen_at")
  manaRegenAt DateTime? @map("mana_regen_at")
  statsJson Json     @map("stats_json")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([raceId])
  @@index([classId])
  @@map("characters")
}

model SoloCombatSession {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  monsterId   String    @map("monster_id")
  stateJson   Json      @map("state_json")
  status      String    @default("active")
  turn        Int       @default(1)
  rewardXp    Int?      @map("reward_xp")
  rewardGold  Int?      @map("reward_gold")
  rewardItemsJson Json? @map("reward_items_json")
  rewardClaimedAt DateTime? @map("reward_claimed_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([characterId, status])
  @@index([monsterId])
  @@index([expiresAt])
  @@map("solo_combat_sessions")
}

model PendingPassageEncounter {
  id                    String    @id @default(uuid())
  token                 String    @unique
  characterId           String    @map("character_id")
  character             Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  originLocationId      String    @map("origin_location_id")
  passage               String
  difficulty            String
  monsterId             String    @map("monster_id")
  baseMonsterLevel      Int       @map("base_monster_level")
  effectiveMonsterLevel Int       @map("effective_monster_level")
  rulesVersion          String    @map("rules_version")
  seedHash              String    @map("seed_hash")
  status                String    @default("pending")
  activeKey             String?   @unique @map("active_key")
  version               Int       @default(1)
  combatSessionId       String?   @map("combat_session_id")
  expiresAt             DateTime  @map("expires_at")
  consumedAt            DateTime? @map("consumed_at")
  cancelledAt           DateTime? @map("cancelled_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([characterId, status, expiresAt])
  @@index([originLocationId])
  @@index([monsterId])
  @@index([combatSessionId])
  @@map("pending_passage_encounters")
}

model CombatBalanceBattle {
  id                       String    @id @default(uuid())
  combatId                 String    @unique @map("combat_id")
  combatSource             String    @map("combat_source")
  outcome                  String
  startedAt                DateTime  @map("started_at")
  finishedAt               DateTime  @map("finished_at")
  balanceVersion           String    @map("balance_version")
  combatEngineVersion      String    @map("combat_engine_version")
  analyticsSchemaVersion   Int       @map("analytics_schema_version")
  playerAnalysisKey        String    @map("player_analysis_key")
  characterId              String    @map("character_id")
  character                Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  isTestOrAdmin            Boolean   @default(false) @map("is_test_or_admin")
  classKey                 String    @map("class_key")
  playerLevel              Int       @map("player_level")
  remortCount              Int       @map("remort_count")
  playerMaxHp              Int       @map("player_max_hp")
  playerHpAtStart          Int       @map("player_hp_at_start")
  playerHpAtEnd            Int       @map("player_hp_at_end")
  playerManaMax            Int       @map("player_mana_max")
  playerManaAtStart        Int       @map("player_mana_at_start")
  playerStatsJson          Json      @map("player_stats_json")
  playerEquipmentJson      Json      @map("player_equipment_json")
  mobTemplateKey           String    @map("mob_template_key")
  mobType                  String    @map("mob_type")
  mobLevel                 Int       @map("mob_level")
  mobBaseLevel             Int?      @map("mob_base_level")
  mobDifficultyTier        String    @map("mob_difficulty_tier")
  mobMaxHp                 Int       @map("mob_max_hp")
  mobHpAtEnd               Int       @map("mob_hp_at_end")
  roundsCount              Int       @map("rounds_count")
  playerActionsCount       Int       @map("player_actions_count")
  manualPlayerActionsCount Int       @default(0) @map("manual_player_actions_count")
  timeoutAutoActionsCount  Int       @default(0) @map("timeout_auto_actions_count")
  timeoutSkipActionsCount  Int       @default(0) @map("timeout_skip_actions_count")
  enemyActionsCount        Int       @map("enemy_actions_count")
  damageDealt              Int       @map("damage_dealt")
  damageTaken              Int       @map("damage_taken")
  healingDone              Int       @default(0) @map("healing_done")
  criticalHits             Int       @default(0) @map("critical_hits")
  misses                   Int       @default(0)
  duplicateWriteAttempts   Int       @default(0) @map("duplicate_write_attempts")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  abilities                CombatBalanceAbilityUsage[]

  @@index([finishedAt])
  @@index([balanceVersion, classKey, playerLevel, remortCount])
  @@index([combatSource, finishedAt])
  @@index([mobTemplateKey, mobLevel])
  @@map("combat_balance_battles")
}

model CombatBalanceAbilityUsage {
  id                      String               @id @default(uuid())
  battleId                String               @map("battle_id")
  battle                  CombatBalanceBattle  @relation(fields: [battleId], references: [id], onDelete: Cascade)
  combatId                String               @map("combat_id")
  abilityKey              String               @map("ability_key")
  actionOrigin            String               @default("manual") @map("action_origin")
  abilityRank             Int                  @default(0) @map("ability_rank")
  isClassAbility          Boolean              @default(false) @map("is_class_ability")
  usesCount               Int                  @map("uses_count")
  successfulUsesCount     Int                  @map("successful_uses_count")
  hitCount                Int                  @default(0) @map("hit_count")
  critCount               Int                  @default(0) @map("crit_count")
  missCount               Int                  @default(0) @map("miss_count")
  totalDamage             Int                  @default(0) @map("total_damage")
  totalHealing            Int                  @default(0) @map("total_healing")
  resourceSpent           Int                  @default(0) @map("resource_spent")
  createdAt               DateTime             @default(now()) @map("created_at")

  @@unique([combatId, abilityKey, abilityRank, actionOrigin])
  @@index([battleId])
  @@index([abilityKey, actionOrigin])
  @@map("combat_balance_ability_usages")
}

model ActiveCombatLease {
  id          String    @id @default(uuid())
  characterId String    @unique @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  kind        String
  referenceId String    @map("reference_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([kind, referenceId])
  @@map("active_combat_leases")
}

model CharacterEquipment {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  slot        String
  itemId      String    @map("item_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([characterId, slot])
  @@index([itemId])
  @@map("character_equipment")
}

model KorchmaRoundPurchase {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  remortCount Int      @default(0) @map("remort_count")
  tier        String
  spentGold   Int       @map("spent_gold")
  localDate   String    @map("local_date")
  drinkKey    String?   @map("drink_key")
  recipientCount Int?   @map("recipient_count")
  offerExpiresAt DateTime? @map("offer_expires_at")
  rulesVersion String?  @map("rules_version")
  snapshotJson Json?    @map("snapshot_json")
  telemetryJson Json?   @map("telemetry_json")
  createdAt   DateTime  @default(now()) @map("created_at")
  recipients  KorchmaRoundRecipient[]

  @@index([characterId])
  @@index([localDate])
  @@map("korchma_round_purchases")
}

model KorchmaRoundRecipient {
  id          String    @id @default(uuid())
  purchaseId String    @map("purchase_id")
  purchase   KorchmaRoundPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  remortCount Int       @default(0) @map("remort_count")
  drinkKey    String    @map("drink_key")
  status      String    @default("offered")
  offeredAt   DateTime  @map("offered_at")
  expiresAt   DateTime  @map("expires_at")
  respondedAt DateTime? @map("responded_at")
  resultJson  Json?     @map("result_json")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([purchaseId, characterId])
  @@index([characterId, status, expiresAt])
  @@map("korchma_round_recipients")
}

model CharacterDrinkState {
  id          String    @id @default(uuid())
  activationId String   @default(uuid()) @map("activation_id")
  characterId String    @unique @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  remortCount Int       @default(0) @map("remort_count")
  drinkKey    String    @map("drink_key")
  phase       String
  startedAt   DateTime  @map("started_at")
  expiresAt   DateTime  @map("expires_at")
  sourceType  String    @map("source_type")
  sourceId    String?   @map("source_id")
  metadataJson Json?    @map("metadata_json")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([activationId])
  @@index([expiresAt])
  @@map("character_drink_states")
}

model ShynokDrinkActivationAudit {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  activationId String   @unique @map("activation_id")
  drinkKey    String    @map("drink_key")
  sourceType  String    @map("source_type")
  sourceId    String?   @map("source_id")
  outcome     String
  combatSessionId String? @map("combat_session_id")
  occurredAt  DateTime  @map("occurred_at")
  metadataJson Json?    @map("metadata_json")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([characterId, outcome, occurredAt])
  @@index([combatSessionId])
  @@map("shynok_drink_activation_audits")
}

model KorchmaDrinkOrder {
  id          String    @id @default(uuid())
  token       String    @unique
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  remortCount Int       @default(0) @map("remort_count")
  drinkKey    String    @map("drink_key")
  priceGold   Int       @map("price_gold")
  status      String    @default("pending")
  replacementJson Json? @map("replacement_json")
  resultJson  Json?     @map("result_json")
  expiresAt   DateTime  @map("expires_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([characterId, status, expiresAt])
  @@map("korchma_drink_orders")
}

model CharacterItem {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  itemId      String    @map("item_id")
  quantity    Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([characterId, itemId])
  @@index([itemId])
  @@map("character_items")
}

model MantokChestRun {
  id                 String    @id @default(uuid())
  characterId        String    @map("character_id")
  character          Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  token              String    @unique
  status             String    @default("pending")
  inputItemsJson     Json      @map("input_items_json")
  outputItemsJson    Json?     @map("output_items_json")
  averageInputScore  Int       @map("average_input_score")
  minimumOutputScore Int       @map("minimum_output_score")
  outputScore        Int?      @map("output_score")
  completedAt        DateTime? @map("completed_at")
  expiredAt          DateTime? @map("expired_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([characterId, status])
  @@map("mantok_chest_runs")
}

model KorchmaMantokSale {
  id          String    @id @default(uuid())
  token       String    @unique
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  remortCount Int       @default(0) @map("remort_count")
  status      String    @default("pending")
  selectionJson Json    @map("selection_json")
  selectionFingerprint String @map("selection_fingerprint")
  nominalValue Int      @default(0) @map("nominal_value")
  payoutGold   Int      @default(0) @map("payout_gold")
  resultJson   Json?    @map("result_json")
  expiresAt    DateTime @map("expires_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([characterId, status, expiresAt])
  @@map("korchma_mantok_sales")
}

model ItemTransfer {
  id                     String    @id @default(uuid())
  token                  String    @unique
  senderCharacterId      String    @map("sender_character_id")
  senderCharacter        Character @relation("ItemTransferSender", fields: [senderCharacterId], references: [id], onDelete: Cascade)
  receiverCharacterId    String    @map("receiver_character_id")
  receiverCharacter      Character @relation("ItemTransferReceiver", fields: [receiverCharacterId], references: [id], onDelete: Cascade)
  senderTelegramUserId   BigInt    @map("sender_telegram_user_id")
  receiverTelegramUserId BigInt    @map("receiver_telegram_user_id")
  senderName             String    @map("sender_name")
  receiverName           String    @map("receiver_name")
  senderRemortCount      Int       @default(0) @map("sender_remort_count")
  receiverRemortCount    Int       @default(0) @map("receiver_remort_count")
  locationId             String?   @map("location_id")
  itemId                 String    @map("item_id")
  itemName               String    @map("item_name")
  itemFingerprint        String    @map("item_fingerprint")
  quantity               Int       @default(1)
  status                 String    @default("pending")
  resultJson             Json?     @map("result_json")
  expiresAt              DateTime  @map("expires_at")
  completedAt            DateTime? @map("completed_at")
  respondedAt            DateTime? @map("responded_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([senderCharacterId, status, expiresAt])
  @@index([receiverCharacterId, status, expiresAt])
  @@index([itemId, status])
  @@map("item_transfers")
}

model BarrelRaidNotification {
  id             String    @id @default(uuid())
  characterId    String    @map("character_id")
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  telegramUserId BigInt    @map("telegram_user_id")
  chatId         BigInt    @map("chat_id")
  periodId       String    @map("period_id")
  availableAt    DateTime  @map("available_at")
  status         String    @default("pending")
  processingStartedAt DateTime? @map("processing_started_at")
  rewardClaimedAt DateTime? @map("reward_claimed_at")
  sentAt         DateTime? @map("sent_at")
  skippedAt      DateTime? @map("skipped_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([telegramUserId, periodId])
  @@index([characterId, status])
  @@index([status, availableAt])
  @@index([status, processingStartedAt])
  @@map("barrel_raid_notifications")
}

model LevelBarterExchange {
  id                 String    @id @default(uuid())
  characterId        String    @map("character_id")
  character          Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  token              String
  status             String    @default("completed")
  inputItemsJson     Json      @map("input_items_json")
  spentGold          Int       @map("spent_gold")
  levelBefore        Int       @map("level_before")
  levelAfter         Int       @map("level_after")
  xpBefore           Int       @map("xp_before")
  xpAfter            Int       @map("xp_after")
  xpCarry            Int       @map("xp_carry")
  itemTotalValue     Int       @map("item_total_value")
  selectedTotalValue Int       @map("selected_total_value")
  overpay            Int
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([characterId, token])
  @@index([characterId, status])
  @@map("level_barter_exchanges")
}

model CharacterRemortDraft {
  id                   String    @id @default(uuid())
  characterId          String    @map("character_id")
  character            Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  token                String    @unique
  status               String    @default("pending")
  selectedIdentityJson Json      @map("selected_identity_json")
  selectedItemsJson    Json      @map("selected_items_json")
  expiresAt            DateTime  @map("expires_at")
  completedAt          DateTime? @map("completed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([characterId, status])
  @@index([expiresAt])
  @@map("character_remort_drafts")
}

model CharacterRemort {
  id                    String    @id @default(uuid())
  characterId           String    @map("character_id")
  character             Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  token                 String    @unique
  remortNumber          Int       @map("remort_number")
  previousLevel         Int       @map("previous_level")
  previousXp            Int       @map("previous_xp")
  previousGold          Int       @map("previous_gold")
  displayNameSnapshot   String    @map("display_name_snapshot")
  preservedPayloadJson  Json      @map("preserved_payload_json")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@unique([characterId, remortNumber])
  @@index([remortNumber, createdAt])
  @@map("character_remorts")
}

model DuelChallenge {
  id                    String    @id @default(uuid())
  challengerCharacterId String    @map("challenger_character_id")
  challenger            Character @relation("DuelChallenger", fields: [challengerCharacterId], references: [id], onDelete: Cascade)
  targetCharacterId     String?   @map("target_character_id")
  target                Character? @relation("DuelTarget", fields: [targetCharacterId], references: [id], onDelete: SetNull)
  contextChatId         BigInt?   @map("context_chat_id")
  inviteToken           String    @unique @map("invite_token")
  mode                  String    @default("quick")
  status                String    @default("pending")
  expiresAt             DateTime  @map("expires_at")
  resolvedAt            DateTime? @map("resolved_at")
  resultJson            Json?     @map("result_json")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  combatSession         DuelCombatSession?

  @@index([challengerCharacterId, status])
  @@index([targetCharacterId, status])
  @@index([status, expiresAt])
  @@map("duel_challenges")
}

model DuelCombatSession {
  id                    String    @id @default(uuid())
  duelChallengeId       String    @unique @map("duel_challenge_id")
  duelChallenge         DuelChallenge @relation(fields: [duelChallengeId], references: [id], onDelete: Cascade)
  challengerCharacterId String    @map("challenger_character_id")
  challenger            Character @relation("DuelCombatChallenger", fields: [challengerCharacterId], references: [id], onDelete: Cascade)
  targetCharacterId     String    @map("target_character_id")
  target                Character @relation("DuelCombatTarget", fields: [targetCharacterId], references: [id], onDelete: Cascade)
  status                String    @default("active")
  actingCharacterId     String    @map("acting_character_id")
  stateJson             Json      @map("state_json")
  turn                  Int       @default(1)
  version               Int       @default(1)
  turnExpiresAt         DateTime  @map("turn_expires_at")
  completedAt           DateTime? @map("completed_at")
  challengerChatId      BigInt?   @map("challenger_chat_id")
  challengerMessageId   Int?      @map("challenger_message_id")
  targetChatId          BigInt?   @map("target_chat_id")
  targetMessageId       Int?      @map("target_message_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  actions               DuelCombatAction[]

  @@index([challengerCharacterId, status])
  @@index([targetCharacterId, status])
  @@index([status, turnExpiresAt])
  @@map("duel_combat_sessions")
}

model DuelCombatAction {
  id               String    @id @default(uuid())
  sessionId        String    @map("session_id")
  session          DuelCombatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actorCharacterId String    @map("actor_character_id")
  turn             Int
  actionKey        String    @map("action_key")
  resultJson       Json      @map("result_json")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@unique([sessionId, turn])
  @@index([actorCharacterId])
  @@map("duel_combat_actions")
}

model DailyAction {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  key         String
  localDate   String    @map("local_date")
  rewardXp    Int       @map("reward_xp")
  rewardGold  Int       @map("reward_gold")
  spentGold   Int       @default(0) @map("spent_gold")
  resultJson  Json?     @map("result_json")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([characterId, key, localDate])
  @@index([key])
  @@map("daily_actions")
}

model HuntContract {
  id              String    @id @default(uuid())
  characterId     String    @map("character_id")
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  localPeriodId   String    @map("local_period_id")
  monsterId       String    @map("monster_id")
  contractToken   String    @map("contract_token")
  status          String    @default("posted")
  completedAction String?   @map("completed_action")
  rewardXp        Int?      @map("reward_xp")
  rewardGold      Int?      @map("reward_gold")
  rewardItemsJson Json?     @map("reward_items_json")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([characterId, localPeriodId])
  @@index([monsterId])
  @@index([localPeriodId])
  @@map("hunt_contracts")
}

model CharacterCooldown {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  key         String
  availableAt DateTime  @map("available_at")
  resultJson  Json?     @map("result_json")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([characterId, key])
  @@index([availableAt])
  @@map("character_cooldowns")
}

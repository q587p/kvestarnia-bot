generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id @default(uuid())
  // Telegram user ids are numeric; convert ctx.from.id to BigInt at the DB boundary.
  telegramUserId     BigInt     @unique @map("telegram_user_id")
  username           String?
  displayName        String?    @map("display_name")
  languageCode       String?    @map("language_code")
  lastActionAt       DateTime?  @map("last_action_at")
  lastSeenLocationId String?    @map("last_seen_location_id")
  currentRaidId      String?    @map("current_raid_id")
  currentAdventureId String?    @map("current_adventure_id")
  character          Character?
  guildMemberships  GuildMember[]
  guildsLed          Guild[]              @relation("GuildLeader")
  guildsFounded      Guild[]              @relation("GuildFounder")
  guildLeadershipNominations Guild[]      @relation("GuildLeadershipNominee")
  guildCreationIntents GuildCreationIntent[]
  guildCrestUploadDrafts GuildCrestUploadDraft[]
  guildInvitesSent   GuildInvite[]         @relation("GuildInviteInviter")
  guildInvitesReceived GuildInvite[]       @relation("GuildInviteTarget")
  guildInviteOptIn   GuildInviteOptIn?
  guildAudits        GuildAudit[]           @relation("GuildAuditActor")
  guildFounderCooldown GuildFounderCooldown?
  referralInviteCode ReferralInviteCode? @relation("ReferralInviteCodeInviter")
  referralAttributionsInvited ReferralAttribution[] @relation("ReferralInviter")
  referralAttributionReceived ReferralAttribution? @relation("ReferralInvitee")
  referralRewardsBenefiting ReferralReward[] @relation("ReferralRewardBeneficiary")
  referralNotifications ReferralNotificationOutbox[] @relation("ReferralNotificationRecipient")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@index([lastActionAt])
  @@index([lastSeenLocationId])
  @@index([currentRaidId])
  @@index([currentAdventureId])
  @@map("users")
}

model ReferralInviteCode {
  id                  String                @id @default(uuid())
  inviterUserId       String                @unique @map("inviter_user_id")
  inviterUser         User                  @relation("ReferralInviteCodeInviter", fields: [inviterUserId], references: [id], onDelete: Restrict)
  token               String                @unique
  inviterNameSnapshot String                @map("inviter_name_snapshot")
  attributions        ReferralAttribution[]
  createdAt           DateTime              @default(now()) @map("created_at")

  @@map("referral_invite_codes")
}

model ReferralAttribution {
  id                String             @id @default(uuid())
  inviterUserId     String             @map("inviter_user_id")
  inviterUser       User               @relation("ReferralInviter", fields: [inviterUserId], references: [id], onDelete: Restrict)
  inviteeUserId     String             @unique @map("invitee_user_id")
  inviteeUser       User               @relation("ReferralInvitee", fields: [inviteeUserId], references: [id], onDelete: Restrict)
  inviteCodeId      String             @map("invite_code_id")
  inviteCode        ReferralInviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Restrict)
  status            String             @default("PENDING")
  capturedAt        DateTime           @map("captured_at")
  acceptedAt        DateTime?          @map("accepted_at")
  declinedAt        DateTime?          @map("declined_at")
  arrivedAt         DateTime?          @map("arrived_at")
  arrivedCharacterId String?           @map("arrived_character_id")
  inviteeNameSnapshot String?          @map("invitee_name_snapshot")
  chronicleRecordedAt DateTime?        @map("chronicle_recorded_at")
  rewardPlanVersion Int?               @map("reward_plan_version")
  rewards           ReferralReward[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([inviterUserId, status, arrivedAt, id])
  @@index([status, chronicleRecordedAt, arrivedAt, id])
  @@map("referral_attributions")
}

model ReferralReward {
  id                   String              @id @default(uuid())
  attributionId        String              @map("attribution_id")
  attribution          ReferralAttribution @relation(fields: [attributionId], references: [id], onDelete: Restrict)
  beneficiaryUserId    String              @map("beneficiary_user_id")
  beneficiaryUser      User                @relation("ReferralRewardBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Restrict)
  rewardFamily         String              @map("reward_family")
  milestoneKey         String              @map("milestone_key")
  sourceAchievementId  String              @map("source_achievement_id")
  rewardPlanVersion    Int                 @map("reward_plan_version")
  rewardGold           Int                 @map("reward_gold")
  rewardItemsJson      Json                @map("reward_items_json")
  state                String              @default("PENDING")
  earnedAt             DateTime            @map("earned_at")
  deliveryAttemptCount Int                 @default(0) @map("delivery_attempt_count")
  nextAttemptAt        DateTime            @map("next_attempt_at")
  lastFailureCode      String?             @map("last_failure_code")
  grantedAt            DateTime?           @map("granted_at")
  grantedCharacterId   String?             @map("granted_character_id")
  grantedCharacter     Character?          @relation("ReferralRewardGrantedCharacter", fields: [grantedCharacterId], references: [id], onDelete: SetNull)
  grantedRemortCount   Int?                @map("granted_remort_count")
  actualGrantJson      Json?               @map("actual_grant_json")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@unique([attributionId, beneficiaryUserId, rewardFamily, milestoneKey])
  @@index([state, nextAttemptAt, earnedAt, id])
  @@index([beneficiaryUserId, state, nextAttemptAt, earnedAt, id])
  @@map("referral_rewards")
}

model ReferralNotificationOutbox {
  id              String    @id @default(uuid())
  logicalKey      String    @unique @map("logical_key")
  kind            String
  recipientUserId String    @map("recipient_user_id")
  recipientUser   User      @relation("ReferralNotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  payloadJson     Json      @map("payload_json")
  state           String    @default("PENDING")
  attemptCount    Int       @default(0) @map("attempt_count")
  nextAttemptAt   DateTime  @map("next_attempt_at")
  claimToken      String?   @map("claim_token")
  claimedUntil    DateTime? @map("claimed_until")
  sentAt          DateTime? @map("sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([kind, state, nextAttemptAt, createdAt, id])
  @@index([kind, state, claimedUntil, createdAt, id])
  @@map("referral_notification_outbox")
}

model GuildFounderCooldown {
  userId      String   @id @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableAt DateTime @map("available_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([availableAt])
  @@map("guild_founder_cooldowns")
}

model Guild {
  id             String   @id @default(uuid())
  normalizedName String   @map("normalized_name")
  reservationKey String?  @unique @map("reservation_key")
  displayName    String   @map("display_name")
  crest          String
  crestKind      String   @default("catalog") @map("crest_kind")
  crestReservationKey String? @unique @map("crest_reservation_key")
  crestFileId    String?  @map("crest_file_id")
  crestFileUniqueId String? @map("crest_file_unique_id")
  crestWidth     Int?     @map("crest_width")
  crestHeight    Int?     @map("crest_height")
  crestFileSize  Int?     @map("crest_file_size")
  description    String
  founderUserId  String   @map("founder_user_id")
  founderUser    User     @relation("GuildFounder", fields: [founderUserId], references: [id], onDelete: Restrict)
  leaderUserId   String   @map("leader_user_id")
  leaderUser     User     @relation("GuildLeader", fields: [leaderUserId], references: [id], onDelete: Restrict)
  leadershipNomineeUserId String? @map("leadership_nominee_user_id")
  leadershipNomineeUser User? @relation("GuildLeadershipNominee", fields: [leadershipNomineeUserId], references: [id], onDelete: SetNull)
  leadershipOfferedAt DateTime? @map("leadership_offered_at")
  status         String   @default("forming")
  version        Int      @default(1)
  charterExpiresAt DateTime @map("charter_expires_at")
  activatedAt    DateTime? @map("activated_at")
  activatedByInviteId String? @map("activated_by_invite_id")
  disbandedAt    DateTime? @map("disbanded_at")
  nameReleaseAt  DateTime? @map("name_release_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  members        GuildMember[]
  creationIntents GuildCreationIntent[]
  invites        GuildInvite[]
  audits         GuildAudit[]
  crestUploadDrafts GuildCrestUploadDraft[]
  weeklyGoalPeriods GuildWeeklyGoalPeriod[]
  weeklyContributions GuildWeeklyContribution[]
  gloryReceipts GuildGloryReceipt[]

  @@index([leaderUserId])
  @@index([founderUserId])
  @@index([status, charterExpiresAt])
  @@index([reservationKey, nameReleaseAt])
  @@index([crestReservationKey, status])
  @@map("guilds")
}

model GuildMember {
  id        String   @id @default(uuid())
  guildId   String   @map("guild_id")
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeUserKey String? @unique @map("active_user_key")
  role      String   @default("member")
  joinedAt  DateTime @map("joined_at")
  leftAt    DateTime? @map("left_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([guildId, activeUserKey, role, joinedAt])
  @@index([userId, leftAt])
  @@map("guild_members")
}

model GuildCreationIntent {
  id             String   @id @default(uuid())
  token          String   @unique
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId    String   @map("character_id")
  remortCount    Int      @map("remort_count")
  normalizedName String   @map("normalized_name")
  displayName    String   @map("display_name")
  crest          String
  crestKind      String   @default("catalog") @map("crest_kind")
  crestFileId    String?  @map("crest_file_id")
  crestFileUniqueId String? @map("crest_file_unique_id")
  crestWidth     Int?     @map("crest_width")
  crestHeight    Int?     @map("crest_height")
  crestFileSize  Int?     @map("crest_file_size")
  description    String
  goldCost       Int      @map("gold_cost")
  status         String   @default("pending")
  activeUserKey  String?  @unique @map("active_user_key")
  guildId        String?  @map("guild_id")
  guild          Guild?   @relation(fields: [guildId], references: [id], onDelete: SetNull)
  crestUploadDraft GuildCrestUploadDraft?
  expiresAt      DateTime @map("expires_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId, status, expiresAt])
  @@index([normalizedName, status])
  @@map("guild_creation_intents")
}

model GuildCrestUploadDraft {
  id             String   @id @default(uuid())
  token          String   @unique
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose        String
  guildId        String?  @map("guild_id")
  guild          Guild?   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  expectedGuildVersion Int? @map("expected_guild_version")
  status         String   @default("pending")
  activeUserKey  String?  @unique @map("active_user_key")
  fileId         String?  @map("file_id")
  fileUniqueId   String?  @map("file_unique_id")
  width          Int?
  height         Int?
  fileSize       Int?     @map("file_size")
  intentId       String?  @unique @map("intent_id")
  intent         GuildCreationIntent? @relation(fields: [intentId], references: [id], onDelete: SetNull)
  expiresAt      DateTime @map("expires_at")
  consumedAt     DateTime? @map("consumed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId, status, expiresAt])
  @@index([guildId, status, expiresAt])
  @@map("guild_crest_upload_drafts")
}

model GuildInvite {
  id            String   @id @default(uuid())
  token         String   @unique
  guildId       String   @map("guild_id")
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  inviterUserId String   @map("inviter_user_id")
  inviterUser   User     @relation("GuildInviteInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  inviterMembershipId String @map("inviter_membership_id")
  targetUserId  String   @map("target_user_id")
  targetUser    User     @relation("GuildInviteTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetName    String   @map("target_name")
  status        String   @default("pending")
  activeKey     String?  @unique @map("active_key")
  expiresAt     DateTime @map("expires_at")
  respondedAt   DateTime? @map("responded_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([guildId, status, expiresAt])
  @@index([targetUserId, status, expiresAt])
  @@index([inviterUserId, createdAt])
  @@map("guild_invites")
}

model GuildInviteOptIn {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("guild_invite_opt_ins")
}

model GuildAudit {
  id            String   @id @default(uuid())
  guildId       String   @map("guild_id")
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  eventType     String   @map("event_type")
  actorUserId   String?  @map("actor_user_id")
  actorUser     User?    @relation("GuildAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  subjectUserId String?  @map("subject_user_id")
  dedupeKey     String   @unique @map("dedupe_key")
  payloadJson   Json?    @map("payload_json")
  occurredAt    DateTime @map("occurred_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([guildId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("guild_audits")
}

model GuildWeeklyGoalPeriod {
  id            String   @id @default(uuid())
  guildId       String   @map("guild_id")
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Restrict)
    periodKey     String   @map("period_key")
    goalKey       String   @map("goal_key")
    guildNameSnapshot String @map("guild_name_snapshot")
    guildCrestSnapshot String @map("guild_crest_snapshot")
    targetCount   Int      @map("target_count")
  progressCount Int      @default(0) @map("progress_count")
  completedAt   DateTime? @map("completed_at")
  devOverrideCompletedAt DateTime? @map("dev_override_completed_at")
  devOverrideUserId String? @map("dev_override_user_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  contributions GuildWeeklyContribution[]
  gloryReceipt GuildGloryReceipt?
  achievementEntitlements GuildWeeklyAchievementEntitlement[]

  @@unique([guildId, periodKey, goalKey])
  @@index([periodKey, completedAt])
  @@map("guild_weekly_goal_periods")
}

model GuildWeeklyContribution {
  id                   String                 @id @default(uuid())
  periodId             String                 @map("period_id")
  period               GuildWeeklyGoalPeriod  @relation(fields: [periodId], references: [id], onDelete: Restrict)
  guildId              String                 @map("guild_id")
  guild                Guild                  @relation(fields: [guildId], references: [id], onDelete: Restrict)
  groupCombatSessionId String                 @unique @map("group_combat_session_id")
  groupCombatSession   GroupCombatSession     @relation(fields: [groupCombatSessionId], references: [id], onDelete: Restrict)
  expeditionCompletedAt DateTime              @map("expedition_completed_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  contributors         GuildWeeklyContributorReceipt[]

  @@unique([periodId, groupCombatSessionId])
  @@index([guildId, expeditionCompletedAt])
  @@map("guild_weekly_contributions")
}

model GuildWeeklyContributorReceipt {
  id             String                    @id @default(uuid())
  contributionId String                    @map("contribution_id")
  contribution   GuildWeeklyContribution   @relation(fields: [contributionId], references: [id], onDelete: Restrict)
  userId         String                    @map("user_id")
  characterId    String                    @map("character_id")
  remortCount    Int                       @map("remort_count")
  createdAt      DateTime                  @default(now()) @map("created_at")

  @@unique([contributionId, userId])
  @@index([userId, createdAt])
  @@map("guild_weekly_contributor_receipts")
}

model GuildWeeklyParticipantSnapshot {
  id             String             @id @default(uuid())
  sessionId      String             @map("session_id")
  session        GroupCombatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId         String             @map("user_id")
  characterId    String             @map("character_id")
  remortCount    Int                @map("remort_count")
  rosterOrder    Int                @map("roster_order")
  createdAt      DateTime           @default(now()) @map("created_at")

  @@unique([sessionId, userId])
  @@unique([sessionId, rosterOrder])
  @@index([userId, sessionId])
  @@map("guild_weekly_participant_snapshots")
}

model GuildWeeklyReconciliation {
  id             String             @id @default(uuid())
  sessionId      String             @unique @map("session_id")
  session        GroupCombatSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  decision       String
  reason         String
  periodKey      String?            @map("period_key")
  reconciledAt   DateTime           @map("reconciled_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  @@index([reconciledAt, sessionId])
  @@map("guild_weekly_reconciliations")
}

model GuildGloryReceipt {
  id             String                @id @default(uuid())
  guildId        String                @map("guild_id")
  guild          Guild                 @relation(fields: [guildId], references: [id], onDelete: Restrict)
  periodId       String                @unique @map("period_id")
  period         GuildWeeklyGoalPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  sourceKey      String                @unique @map("source_key")
  amount         Int
  awardedAt      DateTime              @map("awarded_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([guildId, awardedAt])
  @@map("guild_glory_receipts")
}

model GuildWeeklyAchievementEntitlement {
  id                   String                @id @default(uuid())
  userId               String                @map("user_id")
  achievementId        String                @map("achievement_id")
  sourcePeriodId       String                @map("source_period_id")
  sourcePeriod         GuildWeeklyGoalPeriod @relation(fields: [sourcePeriodId], references: [id], onDelete: Restrict)
  sourcePeriodKey      String                @map("source_period_key")
  entitledAt           DateTime              @map("entitled_at")
  projectedCharacterId String?               @map("projected_character_id")
  projectedRemortCount Int?                  @map("projected_remort_count")
  projectedAt          DateTime?             @map("projected_at")
  notificationClaimToken String?             @map("notification_claim_token")
  notificationClaimedUntil DateTime?         @map("notification_claimed_until")
  notifiedAt           DateTime?             @map("notified_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@unique([userId, achievementId])
  @@index([notifiedAt, notificationClaimedUntil, entitledAt, id])
  @@index([userId, projectedCharacterId, notifiedAt])
  @@map("guild_weekly_achievement_entitlements")
}

model Character {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyActions DailyAction[]
  cooldowns CharacterCooldown[]
  items     CharacterItem[]
  equipment CharacterEquipment[]
  korchmaRoundPurchases KorchmaRoundPurchase[]
  korchmaRoundRecipients KorchmaRoundRecipient[]
  korchmaDrinkOrders KorchmaDrinkOrder[]
  drinkState CharacterDrinkState?
  drinkActivationAudits ShynokDrinkActivationAudit[]
  korchmaMantokSales KorchmaMantokSale[]
  itemTransfersSent ItemTransfer[] @relation("ItemTransferSender")
  itemTransfersReceived ItemTransfer[] @relation("ItemTransferReceiver")
  itemUseOrders ItemUseOrder[]
  huntContracts HuntContract[]
  soloCombatSessions SoloCombatSession[]
  pendingPassageEncounters PendingPassageEncounter[]
  passageSearchActions PassageSearchAction[]
  combatBalanceBattles CombatBalanceBattle[]
  barrelRaidNotifications BarrelRaidNotification[]
  bardPerformances BardPerformance[]
  bardPerformanceReactions BardPerformanceReaction[]
  priestAidActionsGiven NoncombatPriestAidAction[] @relation("PriestAidActor")
  priestAidActionsReceived NoncombatPriestAidAction[] @relation("PriestAidTarget")
  priestBlessingsGiven NoncombatPriestBlessing[] @relation("PriestBlessingActor")
  priestBlessingsReceived NoncombatPriestBlessing[] @relation("PriestBlessingTarget")
  roguePickpocketAttemptsMade NoncombatRoguePickpocketAttempt[] @relation("RoguePickpocketActor")
  roguePickpocketAttemptsReceived NoncombatRoguePickpocketAttempt[] @relation("RoguePickpocketTarget")
  mantokChestRuns MantokChestRun[]
  levelBarterExchanges LevelBarterExchange[]
  achievements CharacterAchievement[]
  achievementProgress CharacterAchievementProgress[]
  cosmeticTitleGrants CharacterCosmeticTitleGrant[]
  remortDrafts CharacterRemortDraft[]
  remorts CharacterRemort[]
  duelChallengesSent DuelChallenge[] @relation("DuelChallenger")
  duelChallengesReceived DuelChallenge[] @relation("DuelTarget")
  duelCombatSessionsAsChallenger DuelCombatSession[] @relation("DuelCombatChallenger")
  duelCombatSessionsAsTarget DuelCombatSession[] @relation("DuelCombatTarget")
  duelTournamentClaims DuelTournamentClaim[]
  partySessionsLed PartySession[] @relation("PartySessionLeader")
  partyParticipants PartyParticipant[]
  partyRaidChatEntries PartyRaidChatEntry[] @relation("PartyRaidChatEntryActor")
  partyRaidChatComposeIntents PartyRaidChatComposeIntent[]
  partyRaidChatAuthorStates PartyRaidChatAuthorState[]
  tavernGameSessionsCreated TavernGameSession[] @relation("TavernGameCreator")
  tavernGameParticipants TavernGameParticipant[]
  partyBossActions PartyBossAction[]
  partyBossSessionsLed PartyBossSession[] @relation("PartyBossSessionLeader")
  groupCombatParticipants GroupCombatParticipant[]
  groupCombatActions GroupCombatAction[]
  groupCombatUiPublicationClaim GroupCombatUiPublicationClaim?
  activeCombatLease ActiveCombatLease?
  hpRecoveryNotification HpRecoveryNotification?
  referralRewardsGranted ReferralReward[] @relation("ReferralRewardGrantedCharacter")
  name      String
  pronoun   String   @default("they")
  path      String   @default("boundary")
  raceId    String   @map("race_id")
  classId   String   @map("class_id")
  level     Int      @default(1)
  xp        Int      @default(0)
  gold      Int      @default(0)
  hpCurrent Int      @default(25) @map("hp_current")
  hpMax     Int      @default(25) @map("hp_max")
  manaCurrent Int    @default(10) @map("mana_current")
  manaMax   Int      @default(10) @map("mana_max")
  hpRegenAt DateTime? @map("hp_regen_at")
  manaRegenAt DateTime? @map("mana_regen_at")
  activeCosmeticTitleGrantId String? @map("active_cosmetic_title_grant_id")
  statsJson Json     @map("stats_json")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([raceId])
  @@index([classId])
  @@map("characters")
}

model ActivityEvent {
  id                  String    @id @default(uuid())
  eventType           String    @map("event_type")
  category            String
  severity            String
  visibility          String    @default("public")
  actorCharacterId    String?   @map("actor_character_id")

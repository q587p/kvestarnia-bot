generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id @default(uuid())
  // Telegram user ids are numeric; convert ctx.from.id to BigInt at the DB boundary.
  telegramUserId     BigInt     @unique @map("telegram_user_id")
  username           String?
  displayName        String?    @map("display_name")
  languageCode       String?    @map("language_code")
  lastActionAt       DateTime?  @map("last_action_at")
  lastSeenLocationId String?    @map("last_seen_location_id")
  currentRaidId      String?    @map("current_raid_id")
  currentAdventureId String?    @map("current_adventure_id")
  character          Character?
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@index([lastActionAt])
  @@index([lastSeenLocationId])
  @@index([currentRaidId])
  @@index([currentAdventureId])
  @@map("users")
}

model Character {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyActions DailyAction[]
  cooldowns CharacterCooldown[]
  items     CharacterItem[]
  equipment CharacterEquipment[]
  korchmaRoundPurchases KorchmaRoundPurchase[]
  huntContracts HuntContract[]
  soloCombatSessions SoloCombatSession[]
  barrelRaidNotifications BarrelRaidNotification[]
  mantokChestRuns MantokChestRun[]
  levelBarterExchanges LevelBarterExchange[]
  remortDrafts CharacterRemortDraft[]
  remorts CharacterRemort[]
  name      String
  pronoun   String   @default("they")
  path      String   @default("boundary")
  raceId    String   @map("race_id")
  classId   String   @map("class_id")
  level     Int      @default(1)
  xp        Int      @default(0)
  gold      Int      @default(0)
  hpCurrent Int      @default(25) @map("hp_current")
  hpMax     Int      @default(25) @map("hp_max")
  manaCurrent Int    @default(10) @map("mana_current")
  manaMax   Int      @default(10) @map("mana_max")
  hpRegenAt DateTime? @map("hp_regen_at")
  manaRegenAt DateTime? @map("mana_regen_at")
  statsJson Json     @map("stats_json")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([raceId])
  @@index([classId])
  @@map("characters")
}

model SoloCombatSession {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  monsterId   String    @map("monster_id")
  stateJson   Json      @map("state_json")
  status      String    @default("active")
  turn        Int       @default(1)
  rewardXp    Int?      @map("reward_xp")
  rewardGold  Int?      @map("reward_gold")
  rewardItemsJson Json? @map("reward_items_json")
  rewardClaimedAt DateTime? @map("reward_claimed_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([characterId, status])
  @@index([monsterId])
  @@index([expiresAt])
  @@map("solo_combat_sessions")
}

model CharacterEquipment {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  slot        String
  itemId      String    @map("item_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([characterId, slot])
  @@index([itemId])
  @@map("character_equipment")
}

model KorchmaRoundPurchase {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  tier        String
  spentGold   Int       @map("spent_gold")
  localDate   String    @map("local_date")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([characterId])
  @@index([localDate])
  @@map("korchma_round_purchases")
}

model CharacterItem {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  itemId      String    @map("item_id")
  quantity    Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([characterId, itemId])
  @@index([itemId])
  @@map("character_items")
}

model MantokChestRun {
  id                 String    @id @default(uuid())
  characterId        String    @map("character_id")
  character          Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  token              String    @unique
  status             String    @default("pending")
  inputItemsJson     Json      @map("input_items_json")
  outputItemsJson    Json?     @map("output_items_json")
  averageInputScore  Int       @map("average_input_score")
  minimumOutputScore Int       @map("minimum_output_score")
  outputScore        Int?      @map("output_score")
  completedAt        DateTime? @map("completed_at")
  expiredAt          DateTime? @map("expired_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([characterId, status])
  @@map("mantok_chest_runs")
}

model BarrelRaidNotification {
  id             String    @id @default(uuid())
  characterId    String    @map("character_id")
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  telegramUserId BigInt    @map("telegram_user_id")
  chatId         BigInt    @map("chat_id")
  periodId       String    @map("period_id")
  availableAt    DateTime  @map("available_at")
  status         String    @default("pending")
  processingStartedAt DateTime? @map("processing_started_at")
  rewardClaimedAt DateTime? @map("reward_claimed_at")
  sentAt         DateTime? @map("sent_at")
  skippedAt      DateTime? @map("skipped_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([telegramUserId, periodId])
  @@index([characterId, status])
  @@index([status, availableAt])
  @@index([status, processingStartedAt])
  @@map("barrel_raid_notifications")
}

model LevelBarterExchange {
  id                 String    @id @default(uuid())
  characterId        String    @map("character_id")
  character          Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  token              String
  status             String    @default("completed")
  inputItemsJson     Json      @map("input_items_json")
  spentGold          Int       @map("spent_gold")
  levelBefore        Int       @map("level_before")
  levelAfter         Int       @map("level_after")
  xpBefore           Int       @map("xp_before")
  xpAfter            Int       @map("xp_after")
  xpCarry            Int       @map("xp_carry")
  itemTotalValue     Int       @map("item_total_value")
  selectedTotalValue Int       @map("selected_total_value")
  overpay            Int
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([characterId, token])
  @@index([characterId, status])
  @@map("level_barter_exchanges")
}

model CharacterRemortDraft {
  id                   String    @id @default(uuid())
  characterId          String    @map("character_id")
  character            Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  token                String    @unique
  status               String    @default("pending")
  selectedIdentityJson Json      @map("selected_identity_json")
  selectedItemsJson    Json      @map("selected_items_json")
  expiresAt            DateTime  @map("expires_at")
  completedAt          DateTime? @map("completed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([characterId, status])
  @@index([expiresAt])
  @@map("character_remort_drafts")
}

model CharacterRemort {
  id                    String    @id @default(uuid())
  characterId           String    @map("character_id")
  character             Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  token                 String    @unique
  remortNumber          Int       @map("remort_number")
  previousLevel         Int       @map("previous_level")
  previousXp            Int       @map("previous_xp")
  previousGold          Int       @map("previous_gold")
  displayNameSnapshot   String    @map("display_name_snapshot")
  preservedPayloadJson  Json      @map("preserved_payload_json")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@unique([characterId, remortNumber])
  @@index([remortNumber, createdAt])
  @@map("character_remorts")
}

model DailyAction {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  key         String
  localDate   String    @map("local_date")
  rewardXp    Int       @map("reward_xp")
  rewardGold  Int       @map("reward_gold")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([characterId, key, localDate])
  @@index([key])
  @@map("daily_actions")
}

model HuntContract {
  id              String    @id @default(uuid())
  characterId     String    @map("character_id")
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  localPeriodId   String    @map("local_period_id")
  monsterId       String    @map("monster_id")
  contractToken   String    @map("contract_token")
  status          String    @default("posted")
  completedAction String?   @map("completed_action")
  rewardXp        Int?      @map("reward_xp")
  rewardGold      Int?      @map("reward_gold")
  rewardItemsJson Json?     @map("reward_items_json")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([characterId, localPeriodId])
  @@index([monsterId])
  @@index([localPeriodId])
  @@map("hunt_contracts")
}

model CharacterCooldown {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  key         String
  availableAt DateTime  @map("available_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([characterId, key])
  @@index([availableAt])
  @@map("character_cooldowns")
}

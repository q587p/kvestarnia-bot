{
  "name": "kvestarnia-bot",
  "version": "0.1.3",
  "private": true,
  "description": "Квестарня — гумористична фентезі-РПҐ у Telegram.",
  "main": "dist/bot.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/bot.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/bot.js",
    "test": "vitest run",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "node scripts/prisma-migrate-dev.cjs",
    "db:deploy": "node scripts/prisma-migrate-deploy.cjs",
    "db:studio": "prisma studio",
    "simulate:combat": "ts-node scripts/simulate-combat.ts",
    "sample:loot": "ts-node scripts/sample-loot.ts",
    "grant:gift": "ts-node scripts/grant-gift-campaign.ts",
    "check": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.34.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.19.21",
    "eslint": "^9.17.0",
    "prisma": "^6.19.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}

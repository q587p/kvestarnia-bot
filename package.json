{
  "name": "kvestarnia-bot",
  "version": "0.4.0",
  "private": true,
  "description": "Квестарня — гумористична фентезі-РПҐ у Telegram.",
  "main": "dist/bot.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/bot.ts",
    "build": "prisma generate && npm run build:ts",
    "build:ts": "node -e \"const fs=require('node:fs'),path=require('node:path'),walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(path.join(d,e.name)):[path.join(d,e.name)]);if(walk('src').filter(f=>f.endsWith('.ts')&&!f.endsWith('.d.ts')).some(f=>!fs.existsSync(path.join('dist',path.relative('src',f).replace(/\\.ts$/,'.js')))))fs.rmSync('.cache/typescript/source.tsbuildinfo',{force:true})\" && tsc --build tsconfig.build.json",
    "start": "node dist/bot.js",
    "test": "npm run test:ci",
    "test:unit": "vitest run --config vitest.unit.config.cjs",
    "test:integration": "vitest run --config vitest.integration.config.cjs",
    "test:ci": "npm run test:unit && npm run test:integration",
    "test:changed": "vitest run --changed",
    "typecheck": "prisma generate && npm run typecheck:ts",
    "typecheck:ts": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json --incremental --tsBuildInfoFile .cache/typescript/scripts.tsbuildinfo",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/backfill-activity-events.ts\" \"scripts/closed-alpha-report.ts\" \"scripts/poll-activity-events.ts\" --cache --cache-location .cache/eslint/main --cache-strategy content --concurrency 4",
    "lint:scripts": "eslint \"scripts/backfill-activity-events.ts\" \"scripts/closed-alpha-report.ts\" \"scripts/poll-activity-events.ts\" --cache --cache-location .cache/eslint/scripts --cache-strategy content",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "node scripts/prisma-migrate-dev.cjs",
    "db:deploy": "node scripts/prisma-migrate-deploy.cjs",
    "db:studio": "prisma studio",
    "simulate:combat": "ts-node scripts/simulate-combat.ts",
    "simulate:passage-encounters": "ts-node scripts/simulate-passage-encounters.ts",
    "report:combat-balance": "ts-node scripts/combat-balance-report.ts",
    "report:closed-alpha": "ts-node scripts/closed-alpha-report.ts",
    "sample:loot": "ts-node scripts/sample-loot.ts",
    "grant:gift": "ts-node scripts/grant-gift-campaign.ts",
    "maintenance:cleanup-remort-daily-actions": "ts-node scripts/cleanup-remort-daily-actions.ts",
    "maintenance:cleanup-remort-yeger-actions": "ts-node scripts/cleanup-remort-daily-actions.ts --yeger-only",
    "maintenance:backfill-activity-events": "node -r ts-node/register/transpile-only scripts/backfill-activity-events.ts",
    "maintenance:poll-activity-events": "node -r ts-node/register/transpile-only scripts/poll-activity-events.ts",
    "maintenance:repair-character-resources": "ts-node scripts/repair-character-resources.ts",
    "check:static": "npm run db:generate && npm run lint && npm run typecheck:scripts && npm run build:ts",
    "check:unit": "npm run test:unit",
    "check:integration": "npm run test:integration",
    "check": "npm run check:static && npm run check:unit && npm run check:integration"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.34.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.19.21",
    "eslint": "^9.17.0",
    "prisma": "^6.19.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
